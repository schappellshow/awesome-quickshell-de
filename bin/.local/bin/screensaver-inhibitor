#!/usr/bin/env python3
"""Serve org.freedesktop.ScreenSaver so video keeps the screen awake.

Firefox, Chrome/Chromium, VLC, mpv, Zoom and friends all call this D-Bus
API to say "I'm playing something, don't blank the screen". Under a full
desktop KDE's powerdevil or GNOME's session manager owns that name; in this
session nothing did, so every request went nowhere and the screen blanked
(and locked) mid-video.

This owns the name, tracks inhibit cookies, and tells quickshell to hold
the screen awake while at least one is active — quickshell already owns the
xset timers via PowerConfig, so routing through it keeps a single writer
rather than two things fighting over xset.

Deliberately tracks the CALLER on the bus too: an app that crashes without
calling UnInhibit would otherwise pin the screen awake forever.
"""

import signal
import subprocess
import sys

import gi
from gi.repository import Gio, GLib

BUS_NAME = "org.freedesktop.ScreenSaver"
# Apps use both paths in the wild; serve each.
OBJECT_PATHS = ("/org/freedesktop/ScreenSaver", "/ScreenSaver")

INTERFACE_XML = """
<node>
  <interface name='org.freedesktop.ScreenSaver'>
    <method name='Inhibit'>
      <arg type='s' name='application_name' direction='in'/>
      <arg type='s' name='reason_for_inhibit' direction='in'/>
      <arg type='u' name='cookie' direction='out'/>
    </method>
    <method name='UnInhibit'>
      <arg type='u' name='cookie' direction='in'/>
    </method>
    <method name='GetActive'>
      <arg type='b' name='active' direction='out'/>
    </method>
  </interface>
</node>
"""


class Inhibitor:
    def __init__(self):
        self.cookies = {}          # cookie -> (sender, app, reason)
        self.watches = {}          # sender -> bus watch id
        self.next_cookie = 1
        self.active = False
        self.connection = None

    # ---- state ----------------------------------------------------------

    def _sync(self):
        """Push the aggregate state to quickshell (idempotent)."""
        want = bool(self.cookies)
        if want == self.active:
            return
        self.active = want
        try:
            subprocess.run(
                ["qs", "ipc", "call", "inhibit",
                 "set" if want else "clear"],
                check=False, timeout=5,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
        except Exception as exc:                      # never die on IPC
            print(f"screensaver-inhibitor: IPC failed: {exc}", file=sys.stderr)
        who = ", ".join(sorted({v[1] for v in self.cookies.values()}))
        print(f"screensaver-inhibitor: {'HOLD' if want else 'RELEASE'}"
              f"{' (' + who + ')' if who else ''}", flush=True)

    def _watch_sender(self, sender):
        if sender in self.watches:
            return
        self.watches[sender] = Gio.bus_watch_name_on_connection(
            self.connection, sender, Gio.BusNameWatcherFlags.NONE,
            None,                                     # appeared
            lambda conn, name: self._sender_gone(name),
        )

    def _sender_gone(self, sender):
        """An app vanished (quit or crashed) — drop everything it held."""
        dropped = [c for c, v in self.cookies.items() if v[0] == sender]
        for c in dropped:
            del self.cookies[c]
        wid = self.watches.pop(sender, None)
        if wid:
            Gio.bus_unwatch_name(wid)
        if dropped:
            print(f"screensaver-inhibitor: {sender} vanished, "
                  f"released {len(dropped)} inhibit(s)", flush=True)
            self._sync()

    # ---- D-Bus ----------------------------------------------------------

    def handle_call(self, conn, sender, path, iface, method, params, invo):
        if method == "Inhibit":
            app, reason = params.unpack()
            cookie = self.next_cookie
            self.next_cookie += 1
            self.cookies[cookie] = (sender, app, reason)
            self._watch_sender(sender)
            print(f"screensaver-inhibitor: inhibit #{cookie} "
                  f"from {app!r} ({reason!r})", flush=True)
            self._sync()
            invo.return_value(GLib.Variant("(u)", (cookie,)))
        elif method == "UnInhibit":
            (cookie,) = params.unpack()
            self.cookies.pop(cookie, None)
            print(f"screensaver-inhibitor: uninhibit #{cookie}", flush=True)
            self._sync()
            invo.return_value(None)
        elif method == "GetActive":
            invo.return_value(GLib.Variant("(b)", (self.active,)))
        else:
            invo.return_error_literal(
                Gio.dbus_error_quark(),
                Gio.DBusError.UNKNOWN_METHOD, f"No such method {method}")

    def on_bus_acquired(self, conn, name):
        self.connection = conn
        info = Gio.DBusNodeInfo.new_for_xml(INTERFACE_XML).interfaces[0]
        for path in OBJECT_PATHS:
            conn.register_object(path, info, self.handle_call, None, None)
        print(f"screensaver-inhibitor: serving {name}", flush=True)

    def on_name_lost(self, conn, name):
        # Something else (a real DE's daemon) owns it — step aside quietly
        print(f"screensaver-inhibitor: {name} taken by another process, "
              f"exiting", file=sys.stderr, flush=True)
        sys.exit(0)


def main():
    inhibitor = Inhibitor()
    Gio.bus_own_name(
        Gio.BusType.SESSION, BUS_NAME,
        Gio.BusNameOwnerFlags.NONE,
        inhibitor.on_bus_acquired, None, inhibitor.on_name_lost,
    )
    loop = GLib.MainLoop()
    for sig in (signal.SIGINT, signal.SIGTERM):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig,
                             lambda: (loop.quit(), False)[1])
    loop.run()


if __name__ == "__main__":
    main()
