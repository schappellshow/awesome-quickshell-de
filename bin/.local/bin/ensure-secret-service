#!/usr/bin/env bash
# Ensure org.freedesktop.secrets is served in this session. Apps that vault
# credentials (Mailspring, browsers, ...) refuse to store logins without it.
#
# ksecretd is KWallet's KF6 secrets daemon — the deliberate KDE exception on
# this setup. kwallet-pam starts it during PAM (`ksecretd --pam-login`),
# already unlocked with the login password, but at that point the session bus
# does not exist: it has no DBUS_SESSION_BUS_ADDRESS, registers no D-Bus name,
# and just waits on $PAM_KWALLET5_LOGIN for the session environment. Plasma
# completes the handoff by running pam_kwallet_init (plasma-kwallet-pam
# .service); an awesome session has to do that itself, which is step 1 below.
#
# Note that the stray PAM daemon also satisfies a pgrep-style "already
# running" guard while serving nothing, and nothing D-Bus-activates
# org.freedesktop.secrets (no matching .service file) — so always test bus
# name ownership, never the process table.
set -u

PAM_INIT=/usr/lib64/libexec/pam_kwallet_init

has_owner() {
    gdbus call --session --dest org.freedesktop.DBus \
        --object-path /org/freedesktop/DBus \
        --method org.freedesktop.DBus.NameHasOwner org.freedesktop.secrets \
        2>/dev/null | grep -q true
}

# Registration is async; poll rather than guessing a sleep
wait_for_owner() {
    local tries=${1:-20}
    while [ "$tries" -gt 0 ]; do
        has_owner && return 0
        sleep 0.5
        tries=$((tries - 1))
    done
    return 1
}

# Into the journal, so a login that ends in a password prompt says which
# path it took. This failed silently for a week after a system update and
# the only visible symptom was KWallet asking for a password again.
log() { logger -t ensure-secret-service -- "$*" 2>/dev/null || true; }

# What the PAM-started daemon is doing, logged only when the handoff fails.
# The failure is otherwise invisible: pam_kwallet_init reports success as
# long as socat could connect, which says nothing about whether the daemon
# on the other end went on to serve anything.
diagnose() {
    log "diagnosis: pam daemon: $(pgrep -a -x ksecretd | tr '\n' ';' || echo none)"
    log "diagnosis: socket $PAM_KWALLET5_LOGIN exists=$([ -S "$PAM_KWALLET5_LOGIN" ] && echo yes || echo no)"
    for name in org.freedesktop.secrets org.kde.kwalletd6 org.kde.ksecretd; do
        owner=$(gdbus call --session --dest org.freedesktop.DBus \
                  --object-path /org/freedesktop/DBus \
                  --method org.freedesktop.DBus.NameHasOwner "$name" 2>/dev/null)
        log "diagnosis: $name -> ${owner:-unavailable}"
    done
}

# Already served (re-run, or awesome restarted mid-session)
has_owner && exit 0

# 1. Preferred: hand the session environment to the PAM-started daemon. It
#    then reaches the bus with the wallet already unlocked — no password
#    prompt. pam_kwallet_init is `env | socat -u STDIN UNIX-CONNECT:$sock`,
#    so it needs the full session env and a live listener on the socket.
#
#    Wait GENEROUSLY here. The budget used to be five seconds, which was a
#    guess that held until a system update made ksecretd slower to start;
#    after it, the daemon was still coming up when the wait expired, step 2
#    killed it, and the session got a password prompt every login. The wait
#    costs nothing when it succeeds -- it returns the moment the name
#    appears -- and the script is spawned asynchronously, so a slow login
#    blocks nothing. Being impatient here throws away an already-unlocked
#    wallet; being patient only ever delays a fallback that is second best
#    anyway.
if [ -n "${PAM_KWALLET5_LOGIN:-}" ] && [ -S "${PAM_KWALLET5_LOGIN}" ] \
   && [ -x "$PAM_INIT" ]; then
    # Record what we are about to hand over. The daemon has been seen to
    # receive the environment and still report no session bus, so the
    # question "did we send a usable DBUS_SESSION_BUS_ADDRESS" has to be
    # answerable from the log rather than inferred.
    log "handing over environment (DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-UNSET}, XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-UNSET})"
    if "$PAM_INIT" 2>/dev/null; then
        # Delivering the environment can succeed into nothing. The socket is
        # created and listened on by pam_kwallet's own helper, not by the
        # daemon, so socat connects happily even when the daemon is already
        # dead -- and it often is: ksecretd builds a KDBusService, which
        # exits the process when it cannot reach the session bus, and PAM
        # starts it before pam_systemd has set XDG_RUNTIME_DIR. So watch the
        # process, not just the clock. Waiting thirty seconds for a pid that
        # no longer exists only delays the fallback.
        tries=60
        while [ "$tries" -gt 0 ]; do
            if has_owner; then
                log "unlocked via kwallet-pam handoff"
                exit 0
            fi
            if ! pgrep -x ksecretd >/dev/null 2>&1; then
                log "the pam-started ksecretd is gone before it registered;" \
                    "KDBusService exits when it cannot reach the session bus." \
                    "First check pam_kwallet runs AFTER pam_systemd in" \
                    "/etc/pam.d -- but note that ksecretd has also been seen" \
                    "to fail this way with a correct address (see the" \
                    "handover line above), which is a ksecretd bug, not this"
                break
            fi
            sleep 0.5
            tries=$((tries - 1))
        done
        [ "$tries" -gt 0 ] || log "org.freedesktop.secrets never appeared in 30s"
        diagnose
    else
        log "pam_kwallet_init failed to deliver the session environment to $PAM_KWALLET5_LOGIN"
    fi
fi

# 2. Fallback: stale socket or dead PAM daemon (e.g. it was killed earlier in
#    the session). Start a plain instance; the wallet will ask for its
#    password the first time an app requests a secret.
#
#    This kills the PAM-started daemon, which is the one holding the wallet
#    already unlocked -- so it is strictly a downgrade and only worth doing
#    once step 1 has genuinely had its chance above.
log "falling back to a plain ksecretd; expect a KWallet password prompt"
pkill -x ksecretd 2>/dev/null
sleep 0.5
setsid /usr/bin/ksecretd >/dev/null 2>&1 </dev/null &

wait_for_owner 20 && exit 0

log "org.freedesktop.secrets never appeared; apps that vault credentials will fail"
echo "ensure-secret-service: org.freedesktop.secrets never appeared" >&2
exit 1
