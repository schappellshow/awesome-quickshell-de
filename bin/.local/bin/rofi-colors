#!/usr/bin/env python3
"""rofi-colors — write the colors rofi should use, from the shell's palette.

    rofi-colors base=#232627 surface=#444444 ...   write the colors file
    rofi-colors path                               print where it lives

Keys: base surface muted text subtext blue bright-blue red. rofi's
openmandriva.rasi imports the file this writes, after its own defaults, so
whatever is written here wins and a missing file leaves the OpenMandriva
colors in force. quickshell's RofiColors.qml calls this whenever the live
palette changes, which makes rofi follow every color scheme and light/dark
mode, not just wallpaper-derived ones.

Values are validated as #rrggbb: they are pasted into a rasi file, and a
stray brace or semicolon would break every later rofi launch.
"""

import os
import re
import sys

KEYS = ("base", "surface", "muted", "text", "subtext", "blue", "bright-blue",
        "red")
HEX = re.compile(r"^#[0-9A-Fa-f]{6}$")
PATH = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
    "quickshell", "rofi-colors.rasi")


def main():
    args = sys.argv[1:]
    if args == ["path"]:
        print(PATH)
        return
    given = {}
    for a in args:
        k, _, v = a.partition("=")
        if k not in KEYS or not HEX.match(v):
            sys.exit("rofi-colors: bad argument %r" % a)
        given[k] = v
    if not given:
        sys.exit(__doc__)
    body = "".join("    %s: %s;\n" % (k, given[k]) for k in KEYS if k in given)
    os.makedirs(os.path.dirname(PATH), exist_ok=True)
    tmp = PATH + ".tmp"
    with open(tmp, "w") as fh:
        fh.write("/* generated by rofi-colors from the shell palette; "
                 "do not edit */\n* {\n%s}\n" % body)
    os.replace(tmp, PATH)


if __name__ == "__main__":
    main()
