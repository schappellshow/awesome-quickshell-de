# Sourced by the X session before the WM starts; everything in the
# session inherits these.

# Identify the session. Without this, apps that ask "what desktop is this?"
# get no answer: XDG autostart OnlyShowIn/NotShowIn can't be evaluated,
# xdg-desktop-portal has no desktop to match a <desktop>-portals.conf
# against, and some apps fall back to guessing.
#
# "awesome" specifically, NOT a borrowed name like KDE or GNOME: claiming
# one of those would pull in that desktop's own configs — /usr/share/
# xdg-desktop-portal/kde-portals.conf would take over portal routing from
# our portals.conf, and every OnlyShowIn=KDE autostart entry (kwrited,
# kaccess, plasma session restore, ...) would suddenly be "for us".
#
# Verified this doesn't disturb the portal: with it set, the appearance
# color-scheme query still answers prefer-dark through the GTK backend,
# because no awesome-portals.conf exists so plain portals.conf still wins.
#
# Note it does NOT fix Electron's secret-service detection — Chromium only
# recognises a fixed set of names (GNOME/KDE/...), so Mailspring still
# needs its explicit --password-store flag.
export XDG_CURRENT_DESKTOP=awesome

# Qt apps outside KDE (quickshell's tray menus, pavucontrol-qt, ...) have
# no platform theme under awesome and default to light Fusion.
#
# qt6ct rather than xdgdesktopportal: the portal theme supplies a color
# scheme but never an icon theme, so Qt's icon lookup finds nothing and
# Quickshell.iconPath() returns image://icon URLs that fail to load.
# qt6ct feeds Qt both. The trade-off is that it reads a static config
# instead of following the portal live, so system-theme-apply rewrites
# that file's color scheme on every dark/light toggle (it also creates
# the file, so this needs no tracked copy).
export QT_QPA_PLATFORMTHEME=qt6ct
