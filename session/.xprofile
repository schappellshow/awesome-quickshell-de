# Sourced by the X session before the WM starts; everything in the
# session inherits these.

# Identify the session. Without this, apps that ask "what desktop is this?"
# get no answer: XDG autostart OnlyShowIn/NotShowIn can't be evaluated,
# xdg-desktop-portal has no desktop to match a <desktop>-portals.conf
# against, and some apps fall back to guessing.
#
# "awesome" specifically, NOT a borrowed name like KDE or GNOME: claiming
# one of those would pull in that desktop's own configs — /usr/share/
# xdg-desktop-portal/kde-portals.conf would take over portal routing from
# our portals.conf, and every OnlyShowIn=KDE autostart entry (kwrited,
# kaccess, plasma session restore, ...) would suddenly be "for us".
#
# Verified this doesn't disturb the portal: with it set, the appearance
# color-scheme query still answers prefer-dark through the GTK backend,
# because no awesome-portals.conf exists so plain portals.conf still wins.
#
# Note it does NOT fix Electron's secret-service detection — Chromium only
# recognises a fixed set of names (GNOME/KDE/...), so Mailspring still
# needs its explicit --password-store flag.
export XDG_CURRENT_DESKTOP=awesome

# Qt apps outside KDE (quickshell's tray menus, pavucontrol-qt, ...) have
# no platform theme under awesome and default to light Fusion.
#
# qt6ct rather than xdgdesktopportal: the portal theme supplies a color
# scheme but never an icon theme, so Qt's icon lookup finds nothing and
# Quickshell.iconPath() returns image://icon URLs that fail to load.
# qt6ct feeds Qt both. The trade-off is that it reads a static config
# instead of following the portal live, so system-theme-apply rewrites
# that file's color scheme on every dark/light toggle (it also creates
# the file, so this needs no tracked copy).
#
# ASK QT WHICH THEMES IT CAN LOAD rather than naming one and hoping. A
# platform theme plugin built against an older Qt stays on disk and is
# silently ignored by the new one -- Qt neither warns nor falls back
# visibly, it just reverts to Fusion's light palette, and the first thing
# anyone notices is grey tray menus on a dark desktop. OpenMandriva moving
# to Qt 6.11 while shipping a qt6ct built for 6.10 did exactly that, and
# the plugin file being present made it look like a config problem.
#
# `kde` (plasma-integration) is the fallback because system-theme-apply
# already keeps kdeglobals in step with qt6ct.conf, so the colours are
# right either way. It is only a fallback: qt6ct is preferred whenever Qt
# can actually see it, since it is the one this desktop configures.
qt_platform_theme() (
    command -v qtdiag6 >/dev/null 2>&1 || return 1
    # offscreen: this runs before anything needs a display, and the theme
    # list does not depend on the platform plugin.
    avail=$(QT_QPA_PLATFORM=offscreen qtdiag6 2>/dev/null \
            | sed -n '/^Theme:/,/^$/p' \
            | sed -n 's/.*available *: *//p' | head -1 | tr -d ' ')
    [ -n "$avail" ] || return 1
    for t in qt6ct kde; do
        case ",$avail," in
            *",$t,"*) printf '%s' "$t"; return 0 ;;
        esac
    done
    return 1
)

QT_QPA_PLATFORMTHEME=$(qt_platform_theme) || QT_QPA_PLATFORMTHEME=qt6ct
export QT_QPA_PLATFORMTHEME

# NOTE ON THE WIDGET STYLE, on the `kde` path only. The style then comes from
# kdeglobals [KDE] widgetStyle, NOT from qt6ct.conf and NOT from
# QT_STYLE_OVERRIDE -- plasma-integration applies its own choice after Qt has
# honoured the variable, so setting it here looks like it works (a plain Qt
# app reports the overridden style) while the shell quietly loads whatever
# kdeglobals names. A leftover kvantum-dark there is enough to style every
# tray menu, margins and translucency included, with no sign of where it came
# from. If Qt apps are themed but the wrong shape, check that key first.

# ── Monitor layout, BEFORE the window manager starts ────────────────────
# quickshell replays the saved xrandr layout too (common/DisplayConfig.qml),
# but it starts from awesome's autostart — i.e. AFTER awesome has already
# enumerated the screens. Reconfiguring outputs underneath a running awesome
# updates each screen's geometry but not the order of its screen objects, so
# the session runs with one order while X has another. Nothing looks wrong
# until awesome is restarted: it then enumerates afresh, gets the real order,
# the indices move, and every window lands on a different monitor.
#
# Applying the layout here means awesome's first enumeration is already the
# final one, and quickshell's replay becomes a no-op that changes nothing.
#
# Use argument arrays, not shell splitting (which differs between bash and
# zsh). Filter disconnected outputs before replaying; a missing dock should
# not invalidate every connected output. Bound both calls so login cannot
# wait forever on RandR. Prefer the most recently written nonempty profile
# if stale per-shell directories from an older config location remain.
if command -v xrandr >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
    python3 - <<'PY'
import json
import os
import pathlib
import re
import shlex
import subprocess
import sys

try:
    state = pathlib.Path(os.environ.get("XDG_STATE_HOME",
                                       os.path.expanduser("~/.local/state")))
    files = sorted((state / "quickshell/by-shell").glob("*/settings.json"),
                   key=lambda p: p.stat().st_mtime, reverse=True)
    command = ""
    for path in files:
        try:
            command = json.loads(path.read_text()).get("displayCmd", "")
        except (OSError, ValueError):
            continue
        if command:
            break
    if command:
        query = subprocess.run(["xrandr", "--query"], capture_output=True,
                               text=True, timeout=10, check=True)
        connected = set(re.findall(r"^(\S+) connected\b", query.stdout, re.M))
        tokens = shlex.split(command)
        args = []
        keep = False
        i = 0
        options = {"--mode": r"\d+x\d+i?", "--pos": r"-?\d+x-?\d+",
                   "--rotate": r"normal|left|right|inverted",
                   "--rate": r"\d+(?:\.\d+)?"}
        while i < len(tokens):
            token = tokens[i]
            if token == "--output":
                name = tokens[i + 1]
                if not re.fullmatch(r"[A-Za-z0-9_.:-]+", name):
                    raise ValueError("Invalid output name")
                keep = name in connected
                if keep:
                    args.extend([token, name])
                i += 2
            elif token in options:
                value = tokens[i + 1]
                if not re.fullmatch(options[token], value):
                    raise ValueError("Invalid display option")
                if keep:
                    args.extend([token, value])
                i += 2
            elif token in ("--primary", "--noprimary", "--off"):
                if keep:
                    args.append(token)
                i += 1
            else:
                raise ValueError("Unsupported saved display option")
        if args:
            subprocess.run(["xrandr", *args], timeout=15, check=True)
except (OSError, ValueError, IndexError, subprocess.SubprocessError) as error:
    print("Monitor layout restore:", error, file=sys.stderr)
PY
fi
